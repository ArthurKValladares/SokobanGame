{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-ninja",
      "hidden": true,
      "description": "Shared settings for the everyday Windows builds: Ninja with MSVC, so every source compiles in parallel. Visual Studio's Open Folder mode supplies the compiler environment; from a shell, use a Developer PowerShell for VS 2022.",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "SOKOBAN_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug (Ninja, MSVC)",
      "description": "Everyday Windows build: Debug with the editor, developer tools, and Vulkan validation.",
      "inherits": "windows-msvc-ninja",
      "binaryDir": "${sourceDir}/out/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja, MSVC)",
      "description": "Optimized Windows build of the game and tests. The editor, developer tools, and validation exist only in Debug builds; use the shipping presets for player packages.",
      "inherits": "windows-msvc-ninja",
      "binaryDir": "${sourceDir}/out/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "headless-tests",
      "displayName": "Headless tests (no Vulkan)",
      "description": "Vulkan-free Debug build of the core, UI, and every SDK-independent test. Builds no game.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/headless-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_DISABLE_FIND_PACKAGE_Vulkan": "ON",
        "SOKOBAN_HEADLESS_TESTS_ONLY": "ON",
        "SOKOBAN_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-ci",
      "hidden": true,
      "description": "Shared Linux quality settings, used locally and by Required Tests CI. Requires the Linux SDL build dependencies and Vulkan SDK.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc-13",
        "CMAKE_CXX_COMPILER": "g++-13",
        "SOKOBAN_BUILD_TESTS": "ON",
        "SOKOBAN_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-clang-ci",
      "hidden": true,
      "inherits": "linux-ci",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-18",
        "CMAKE_CXX_COMPILER": "clang++-18"
      }
    },
    {
      "name": "ci-debug",
      "displayName": "CI: GCC Debug",
      "inherits": "linux-ci",
      "cacheVariables": {
        "SOKOBAN_BUILD_VULKAN_SMOKE_TESTS": "ON"
      }
    },
    {
      "name": "ci-release",
      "displayName": "CI: GCC Release",
      "inherits": "linux-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci-sanitize",
      "displayName": "CI: Clang ASan + UBSan",
      "inherits": "linux-clang-ci",
      "cacheVariables": {
        "SOKOBAN_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "ci-tidy",
      "displayName": "CI: clang-tidy",
      "inherits": "linux-clang-ci",
      "cacheVariables": {
        "SOKOBAN_BUILD_TESTS": "OFF",
        "SOKOBAN_ENABLE_CLANG_TIDY": "ON",
        "SOKOBAN_CLANG_TIDY_EXECUTABLE": "clang-tidy-18",
        "SOKOBAN_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "ci-fuzz",
      "displayName": "CI: player-profile fuzzing",
      "inherits": "linux-clang-ci",
      "cacheVariables": {
        "SOKOBAN_BUILD_TESTS": "OFF",
        "SOKOBAN_BUILD_FUZZ_TESTS": "ON",
        "SOKOBAN_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "shipping",
      "displayName": "Shipping package (x64)",
      "description": "Editor-free Release build with LTO and a separate PDB symbols package.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/shipping",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "SOKOBAN_SHIPPING_BUILD": "ON"
      }
    },
    {
      "name": "shipping-installer",
      "displayName": "Shipping installer (x64)",
      "description": "Editor-free Release installer. Requires Inno Setup 6.",
      "inherits": "shipping",
      "binaryDir": "${sourceDir}/out/shipping-installer",
      "cacheVariables": {
        "SOKOBAN_BUILD_INSTALLER": "ON"
      }
    },
    {
      "name": "shipping-signed",
      "displayName": "Signed shipping installer (x64)",
      "description": "Installer with verified Authenticode signatures. Requires Inno Setup, signtool, and a certificate thumbprint.",
      "inherits": "shipping-installer",
      "binaryDir": "${sourceDir}/out/shipping-signed",
      "cacheVariables": {
        "SOKOBAN_SIGN_ARTIFACTS": "ON",
        "SOKOBAN_SIGNING_CERTIFICATE_THUMBPRINT": "$env{SOKOBAN_SIGNING_CERTIFICATE_THUMBPRINT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ci-debug",
      "configurePreset": "ci-debug"
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release"
    },
    {
      "name": "ci-sanitize",
      "configurePreset": "ci-sanitize"
    },
    {
      "name": "ci-tidy",
      "configurePreset": "ci-tidy",
      "targets": ["sokoban"]
    },
    {
      "name": "ci-fuzz",
      "configurePreset": "ci-fuzz",
      "targets": ["sokoban_player_profile_fuzz"]
    },
    {
      "name": "dev",
      "displayName": "Debug: game only",
      "description": "Builds the game, its content, and nothing else: the inner loop.",
      "configurePreset": "dev",
      "targets": [
        "sokoban"
      ]
    },
    {
      "name": "dev-all",
      "displayName": "Debug: game + tests",
      "description": "The game and every test runner the dev test preset uses.",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "displayName": "Release: game only",
      "description": "An optimized game and its content, without the editor.",
      "configurePreset": "release",
      "targets": [
        "sokoban"
      ]
    },
    {
      "name": "release-all",
      "displayName": "Release: game + tests",
      "description": "The optimized game and every test runner the release test preset uses.",
      "configurePreset": "release"
    },
    {
      "name": "headless-tests",
      "displayName": "Headless tests (no Vulkan)",
      "description": "Only the Vulkan-independent test suites, as the SDK-free CI job builds them. There is no game in this build.",
      "configurePreset": "headless-tests"
    },
    {
      "name": "shipping",
      "displayName": "Shipping: game package",
      "description": "Editor-free Release game with LTO; package it with cpack --preset shipping.",
      "configurePreset": "shipping",
      "configuration": "Release",
      "targets": [
        "sokoban"
      ]
    },
    {
      "name": "shipping-installer",
      "displayName": "Shipping: installer",
      "description": "The per-user Windows installer. Requires Inno Setup 6.",
      "configurePreset": "shipping-installer",
      "configuration": "Release",
      "targets": [
        "sokoban_installer"
      ]
    },
    {
      "name": "shipping-signed",
      "displayName": "Shipping: signed installer",
      "description": "The installer with verified Authenticode signatures. Requires a signing certificate.",
      "configurePreset": "shipping-signed",
      "configuration": "Release",
      "targets": [
        "sokoban_sign_installer"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "linux-ci-tests",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 60
      }
    },
    {
      "name": "ci-debug",
      "inherits": "linux-ci-tests",
      "configurePreset": "ci-debug"
    },
    {
      "name": "ci-release",
      "inherits": "linux-ci-tests",
      "configurePreset": "ci-release"
    },
    {
      "name": "ci-sanitize",
      "inherits": "linux-ci-tests",
      "configurePreset": "ci-sanitize",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug tests",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120,
        "jobs": 4
      }
    },
    {
      "name": "release",
      "displayName": "Release tests",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120,
        "jobs": 4
      }
    },
    {
      "name": "headless-tests",
      "displayName": "Headless tests (no Vulkan)",
      "configurePreset": "headless-tests",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev-check",
      "displayName": "Windows Debug: configure, build every target, test",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev-all" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "release-check",
      "displayName": "Windows Release: configure, build every target, test",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release-all" },
        { "type": "test", "name": "release" }
      ]
    },
    {
      "name": "ci-debug",
      "steps": [
        { "type": "configure", "name": "ci-debug" },
        { "type": "build", "name": "ci-debug" },
        { "type": "test", "name": "ci-debug" }
      ]
    },
    {
      "name": "ci-release",
      "steps": [
        { "type": "configure", "name": "ci-release" },
        { "type": "build", "name": "ci-release" },
        { "type": "test", "name": "ci-release" }
      ]
    },
    {
      "name": "ci-sanitize",
      "steps": [
        { "type": "configure", "name": "ci-sanitize" },
        { "type": "build", "name": "ci-sanitize" },
        { "type": "test", "name": "ci-sanitize" }
      ]
    }
  ],
  "packagePresets": [
    {
      "name": "shipping",
      "configurePreset": "shipping",
      "configurations": ["Release"],
      "generators": [
        "ZIP"
      ]
    }
  ]
}
