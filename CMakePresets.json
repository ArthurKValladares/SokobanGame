{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "shipping",
      "displayName": "Shipping package (x64)",
      "description": "Editor-free Release build with LTO and a separate PDB symbols package.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/shipping",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "SOKOBAN_SHIPPING_BUILD": "ON"
      }
    },
    {
      "name": "shipping-installer",
      "displayName": "Shipping installer (x64)",
      "description": "Editor-free Release installer. Requires Inno Setup 6.",
      "inherits": "shipping",
      "binaryDir": "${sourceDir}/out/shipping-installer",
      "cacheVariables": {
        "SOKOBAN_BUILD_INSTALLER": "ON"
      }
    },
    {
      "name": "shipping-signed",
      "displayName": "Signed shipping installer (x64)",
      "description": "Installer with verified Authenticode signatures. Requires Inno Setup, signtool, and a certificate thumbprint.",
      "inherits": "shipping-installer",
      "binaryDir": "${sourceDir}/out/shipping-signed",
      "cacheVariables": {
        "SOKOBAN_SIGN_ARTIFACTS": "ON",
        "SOKOBAN_SIGNING_CERTIFICATE_THUMBPRINT": "$env{SOKOBAN_SIGNING_CERTIFICATE_THUMBPRINT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "shipping",
      "configurePreset": "shipping",
      "configuration": "Release",
      "targets": [
        "sokoban"
      ]
    },
    {
      "name": "shipping-installer",
      "configurePreset": "shipping-installer",
      "configuration": "Release",
      "targets": [
        "sokoban_installer"
      ]
    },
    {
      "name": "shipping-signed",
      "configurePreset": "shipping-signed",
      "configuration": "Release",
      "targets": [
        "sokoban_sign_installer"
      ]
    }
  ],
  "packagePresets": [
    {
      "name": "shipping",
      "configurePreset": "shipping",
      "configurations": ["Release"],
      "generators": [
        "ZIP"
      ]
    }
  ]
}
