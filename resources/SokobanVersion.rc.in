#include <windows.h>

IDI_SOKOBAN_ICON ICON "@SOKOBAN_ICON_RESOURCE@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SOKOBAN_WINDOWS_VERSION_COMMAS@
 PRODUCTVERSION @SOKOBAN_WINDOWS_VERSION_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@SOKOBAN_APP_PUBLISHER@\0"
            VALUE "FileDescription", "@SOKOBAN_PRODUCT_NAME@\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "sokoban\0"
            VALUE "LegalCopyright", "Copyright (c) @SOKOBAN_COPYRIGHT_YEAR@ @SOKOBAN_APP_PUBLISHER@\0"
            VALUE "OriginalFilename", "sokoban.exe\0"
            VALUE "ProductName", "@SOKOBAN_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
