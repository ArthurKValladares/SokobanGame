# Editor defaults that agree with .gitattributes and .clang-format.
#
# .gitattributes stores every text file with LF and checks it out with LF.
# This file makes editors write LF too, so a file saved on Windows does not
# come back with CRLF and a line-ending warning on every diff.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{cpp,hpp,h,def,cmake,py}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[CMakeLists.txt]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Windows tooling that expects CRLF; the same list as .gitattributes.
[*.{bat,cmd,sln,props,vcxproj,filters}]
end_of_line = crlf

# Vendored code keeps whatever upstream ships.
[third_party/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
